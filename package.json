{
  "name": "next-harness",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "depcruise": "depcruise src --config .dependency-cruiser.json",
    "knip": "knip",
    "jscpd": "jscpd src",
    "audit": "node tooling/harness/cli.ts audit",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "node tooling/harness/cli.ts check ci",
    "harness:blocks": "node tooling/harness/cli.ts blocks",
    "harness:lock": "node tooling/harness/cli.ts lock",
    "harness:unlock": "node tooling/harness/cli.ts unlock",
    "harness:split": "node scripts/split-harness.ts",
    "codex:hooks": "node tooling/harness/cli.ts init --codex-user",
    "prepare": "git config core.hooksPath .githooks",
    "rename": "node scripts/rename.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "1.68.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "shadcn": "4.23.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dependency-cruiser": "18.7.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "jiti": "2.7.0",
    "jscpd": "5.4.2",
    "knip": "6.44.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.4.2",
  "type": "module"
}
